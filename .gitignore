# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
dist/
build/
*.egg-info/

# Secrets - never commit
.env
.env.*
!.env.example
*.pem
*.key

# Local runtime data (results, logs, databases)
runs/
logs/
*.db
*.sqlite

# Private working documents and data you don't own - never commit
*.docx
*.xlsx
*.pdf
private/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Showcase (static site; build output is deployed by CI, not committed)
showcase/node_modules/
showcase/dist/
