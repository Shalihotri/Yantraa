# Copy this file to .env and fill in your own key. .env is git-ignored and never leaves your computer.
# Without a key, the app runs fully in Practice mode (no AI, no cost).
OPENAI_API_KEY=

# Optional overrides
# YANTRAA_DECISIONS_MODEL=gpt-6-luna   # model for the Decisions API ("Real AI")
# YANTRAA_OPENAI_MODEL=gpt-6-luna      # model for the Responses API fallback
